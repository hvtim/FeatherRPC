# {{{ }}} macros are resolved once, at SRPM-generation time (real .git
# present), and baked into the packaged spec as static text - unlike
# %global %(shell), which is live and re-runs with no .git at build time.

function featherrpc_tag {
    tag=$(git describe --tags --abbrev=0 2>/dev/null)
    if [ -z "$tag" ]; then
        tag=v0.0.0
    fi
    echo -n "$tag"
}

function featherrpc_version {
    tag=$(git describe --tags --abbrev=0 2>/dev/null)
    if [ -z "$tag" ]; then
        tag=v0.0.0
    fi
    echo -n "${tag#v}"
}

function featherrpc_rpmversion {
    tag=$(git describe --tags --abbrev=0 2>/dev/null)
    if [ -z "$tag" ]; then
        tag=v0.0.0
    fi
    ver=${tag#v}
    echo -n "${ver/-/\~}"
}
